# Auto-detect text files and normalize line endings to LF
* text=auto

# Text files with explicit LF
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.py text eol=lf
*.webmanifest text eol=lf
.gitignore text eol=lf
LICENSE text eol=lf

# Windows batch scripts must preserve CRLF
*.bat text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.xlsx binary
